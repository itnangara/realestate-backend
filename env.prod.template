# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Real Estate Application - FastAPI Backend
# ============================================
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file to version control
# 2. Use strong, randomly generated secrets
# 3. Rotate secrets regularly
# 4. Use different values for each environment (dev/staging/prod)
# 5. Store secrets in a secure secret manager (AWS Secrets Manager, HashiCorp Vault, etc.)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.prod
# 2. Fill in all the values below
# 3. Never commit .env.prod to Git
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For Docker Compose: postgresql://user:password@db:5432/database
# For external database: postgresql://user:password@your-db-host:5432/database
DATABASE_URL=postgresql://your_db_user:your_secure_password@db:5432/real_estate_prod

# Database credentials (if not using full URL)
POSTGRES_DB=real_estate_prod
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password_change_this

# ============================================
# REDIS CONFIGURATION
# ============================================
# Redis connection URL
# For Docker Compose: redis://redis:6379
# For external Redis: redis://:password@your-redis-host:6379
# For Redis with password: redis://:password@host:6379
REDIS_URL=redis://:your_redis_password@redis:6379

# Redis password (required for production)
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_redis_password_change_this

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
# Secret key for JWT token signing
# MUST be changed - generate with: openssl rand -hex 32
# Minimum 32 characters, use 64+ for production
SECRET_KEY=your_super_secret_key_minimum_32_chars_but_use_64_for_production_change_this_now

# JWT algorithm (HS256 is standard, RS256 for more security)
ALGORITHM=HS256

# Token expiration time in minutes (30 = 30 minutes, 1440 = 24 hours)
# Production recommendation: 30-60 minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins (comma-separated, no spaces between commas)
# Add your production frontend URLs here
# Example: https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# TRUSTED HOSTS
# ============================================
# Allowed host patterns (comma-separated, no spaces between commas)
# Use wildcards for subdomains: *.yourdomain.com
# Example: yourdomain.com,*.yourdomain.com
TRUSTED_HOSTS=yourdomain.com,*.yourdomain.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Environment (production, staging, development)
ENVIRONMENT=production

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Production: INFO or WARNING
LOG_LEVEL=INFO

# Application URL (for generating absolute URLs)
# Example: https://api.yourdomain.com
APP_URL=https://api.yourdomain.com

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
# Prometheus metrics enabled (true/false)
PROMETHEUS_ENABLED=true

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================
# PERFORMANCE & SCALING (GUNICORN)
# ============================================
# Number of Gunicorn worker processes
# Formula: (2 * CPU cores) + 1
# Example: For 2 CPU cores: (2 * 2) + 1 = 5 workers
# Default: 4 workers
GUNICORN_WORKERS=4

# Request timeout in seconds for Gunicorn
# How long to wait for a worker to process a request before timing out
# Default: 120 seconds
GUNICORN_TIMEOUT=120

# Keep-alive timeout in seconds for Gunicorn
# How long to wait for requests on a Keep-Alive connection
# Default: 5 seconds
GUNICORN_KEEP_ALIVE=5

# ============================================
# FILE STORAGE (Optional - for S3/Azure/GCP)
# ============================================
# AWS S3 Configuration (if using S3 for file storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# SMTP settings for sending emails
# MAIL_USERNAME=your_email@domain.com
# MAIL_PASSWORD=your_app_password
# MAIL_FROM=your_email@domain.com
# MAIL_PORT=587
# MAIL_SERVER=smtp.gmail.com
# MAIL_TLS=true
# MAIL_SSL=false

# ============================================
# RATE LIMITING
# ============================================
# Default rate limit (requests per minute per IP)
# Can be overridden per endpoint
RATE_LIMIT_PER_MINUTE=60

# ============================================
# DATABASE POOL CONFIGURATION
# ============================================
# Connection pool settings (already configured in code, but documented)
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# SQLALCHEMY_POOL_RECYCLE=3600

# ============================================
# DEVELOPMENT FEATURES (DISABLE IN PRODUCTION)
# ============================================
# Disable API docs in production (true/false)
# Set to true to hide /api/docs and /api/redoc
DISABLE_API_DOCS=false

# Debug mode (MUST be false in production)
DEBUG=false

# ============================================
# NOTES & INSTRUCTIONS
# ============================================
# 1. Generate SECRET_KEY: openssl rand -hex 32
# 2. Generate REDIS_PASSWORD: openssl rand -base64 32
# 3. Update CORS_ORIGINS with your actual frontend URLs
# 4. Update TRUSTED_HOSTS with your actual domain
# 5. Set strong database passwords
# 6. Review and configure optional services (S3, Email, Sentry)
# 7. Test in staging environment first before production
# 8. Keep backups of this file in a secure location (password manager)
# ============================================

